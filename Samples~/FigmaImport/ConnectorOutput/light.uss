:root {
    --brand-primary: rgba(232, 93, 4, 1);
    --brand-on-primary: rgba(255, 255, 255, 1);
    --surface-card: rgba(250, 247, 242, 1);
    --surface-raised: rgba(255, 255, 255, 0.96);
    --surface-art: rgba(254, 215, 170, 1);
    --text-primary: rgba(28, 25, 23, 1);
    --text-secondary: rgba(87, 83, 78, 1);
    --overlay-scrim: rgba(28, 25, 23, 0.6);
}
