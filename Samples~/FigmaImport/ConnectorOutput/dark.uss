:root {
    --brand-primary: rgba(251, 146, 60, 1);
    --brand-on-primary: rgba(28, 25, 23, 1);
    --surface-card: rgba(41, 37, 36, 1);
    --surface-raised: rgba(68, 64, 60, 0.96);
    --surface-art: rgba(124, 45, 18, 1);
    --text-primary: rgba(250, 250, 249, 1);
    --text-secondary: rgba(214, 211, 209, 1);
    --overlay-scrim: rgba(0, 0, 0, 0.7);
}
