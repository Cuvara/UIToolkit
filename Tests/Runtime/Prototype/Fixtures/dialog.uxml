<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="Dialog" style="width: 400px; height: 240px; flex-shrink: 0; background-color: rgb(120, 40, 40);">
        <ui:Button name="YesButton" text="Yes" style="width: 150px; height: 60px; margin: 20px;" />
        <ui:Button name="NoButton" text="No" style="width: 150px; height: 60px; margin: 20px;" />
    </ui:VisualElement>
</ui:UXML>
