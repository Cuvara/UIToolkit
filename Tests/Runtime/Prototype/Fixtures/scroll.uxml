<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="Scrolls" style="width: 100%; height: 100%; background-color: rgb(30, 30, 30);">
        <ui:ScrollView name="HBar" mode="Horizontal" vertical-scroller-visibility="Hidden" style="position: absolute; left: 100px; top: 100px; width: 300px; height: 80px;">
            <ui:VisualElement name="HContent" style="flex-direction: row; height: 60px;">
                <ui:VisualElement name="H0" style="width: 150px; height: 60px; background-color: rgb(60, 60, 60);" />
                <ui:VisualElement name="H1" style="width: 150px; height: 60px; background-color: rgb(90, 90, 90);" />
                <ui:VisualElement name="H2" style="width: 150px; height: 60px; background-color: rgb(60, 60, 60);" />
                <ui:VisualElement name="H3" style="width: 150px; height: 60px; background-color: rgb(90, 90, 90);" />
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:ScrollView name="WrapList" mode="Vertical" horizontal-scroller-visibility="Hidden" style="position: absolute; left: 100px; top: 300px; width: 320px; height: 160px;">
            <ui:VisualElement name="WrapContent" style="flex-direction: row; flex-wrap: wrap; align-content: flex-start;">
                <ui:VisualElement name="W0" style="width: 100px; height: 60px; background-color: rgb(60, 60, 60);" />
                <ui:VisualElement name="W1" style="width: 100px; height: 60px; background-color: rgb(90, 90, 90);" />
                <ui:VisualElement name="W2" style="width: 100px; height: 60px; background-color: rgb(60, 60, 60);" />
                <ui:VisualElement name="W3" style="width: 100px; height: 60px; background-color: rgb(90, 90, 90);" />
                <ui:VisualElement name="W4" style="width: 100px; height: 60px; background-color: rgb(60, 60, 60);" />
                <ui:VisualElement name="W5" style="width: 100px; height: 60px; background-color: rgb(90, 90, 90);" />
                <ui:VisualElement name="W6" style="width: 100px; height: 60px; background-color: rgb(60, 60, 60);" />
                <ui:VisualElement name="W7" style="width: 100px; height: 60px; background-color: rgb(90, 90, 90);" />
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:ScrollView name="Fits" mode="Horizontal" vertical-scroller-visibility="Hidden" style="position: absolute; left: 100px; top: 520px; width: 300px; height: 80px;">
            <ui:VisualElement name="FitsContent" style="flex-direction: row; height: 60px;">
                <ui:VisualElement name="F0" style="width: 100px; height: 60px; background-color: rgb(60, 60, 60);" />
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
