<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement name="Detail" style="width: 100%; height: 100%; background-color: rgb(20, 60, 20);">
        <ui:Button name="BackButton" text="Back" style="position: absolute; left: 100px; top: 100px; width: 200px; height: 60px;" />
        <ui:Button name="DialogButton" text="Dialog" style="position: absolute; left: 100px; top: 200px; width: 200px; height: 60px;" />
        <ui:Button name="ToggleDialogButton" text="Toggle" style="position: absolute; left: 100px; top: 300px; width: 200px; height: 60px;" />
        <ui:Button name="HoverTarget" text="Hover" style="position: absolute; left: 400px; top: 100px; width: 200px; height: 60px;" />
        <ui:Label name="Tip" text="tip" style="position: absolute; left: 400px; top: 200px; display: none;" />
    </ui:VisualElement>
</ui:UXML>
